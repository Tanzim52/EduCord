# ===== SERVER (.env in apps/server/) =====
PORT=5000
MONGODB_URI=mongodb+srv://username:password@cluster.mongodb.net/eduai?retryWrites=true&w=majority
JWT_SECRET=your_super_secret_jwt_key_here
CLIENT_URL=http://localhost:3000

# AI (pick one - both are FREE)
OLLAMA_URL=http://localhost:11434
AI_MODEL=llama3.2
# GROQ_API_KEY=your_free_groq_key   # Alternative: https://console.groq.com

# Payment (optional - Stripe test mode is free)
# STRIPE_SECRET_KEY=sk_test_...
# STRIPE_WEBHOOK_SECRET=whsec_...

# ===== WEB (.env.local in apps/web/) =====
NEXT_PUBLIC_API_URL=http://localhost:5000/api
NEXT_PUBLIC_IMGBB_API_KEY=your_imgbb_key_here
NEXT_PUBLIC_EMAILJS_SERVICE_ID=your_emailjs_service_id
NEXT_PUBLIC_EMAILJS_PUBLIC_KEY=your_emailjs_public_key
NEXT_PUBLIC_EMAILJS_RESET_TEMPLATE=your_emailjs_reset_template_id
NEXT_PUBLIC_EMAILJS_NOTIFICATION_TEMPLATE=your_emailjs_notification_template_id
# NEXT_PUBLIC_STRIPE_PUBLISHABLE_KEY=pk_test_...
